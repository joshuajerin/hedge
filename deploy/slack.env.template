# Copy outside the checkout to ~/.hedge/slack.env, fill only with fresh rotated
# credentials from seven newly created Slack apps, then chmod 600 that file.
HEDGE_SLACK_CREDENTIALS_ROTATED=1
HEDGE_CIO_MODEL=gemini-3.8-flash
HEDGE_SLACK_STATE_DB=~/.hedge/slack-state.sqlite3
HEDGE_APPROVED_CHANNEL_IDS=REPLACE_WITH_TEST_CHANNEL_ID
HEDGE_SLACK_ACTION_SECRET=REPLACE_WITH_FRESH_LOCAL_RANDOM_SECRET

# CIO only: a fresh bot token and its sole Socket Mode app token.
SLACK_BOT_TOKEN=REPLACE_WITH_FRESH_CIO_BOT_TOKEN
SLACK_APP_TOKEN=REPLACE_WITH_FRESH_CIO_SOCKET_MODE_TOKEN

# Specialists: each value belongs to its matching outbound-only Slack app.
HEDGE_MARKET_SCOUT_BOT_TOKEN=REPLACE_WITH_FRESH_MARKET_SCOUT_BOT_TOKEN
HEDGE_TREND_ANALYST_BOT_TOKEN=REPLACE_WITH_FRESH_TREND_ANALYST_BOT_TOKEN
HEDGE_NEWS_ANALYST_BOT_TOKEN=REPLACE_WITH_FRESH_NEWS_ANALYST_BOT_TOKEN
HEDGE_PORTFOLIO_MANAGER_BOT_TOKEN=REPLACE_WITH_FRESH_PORTFOLIO_MANAGER_BOT_TOKEN
HEDGE_BACKTESTER_BOT_TOKEN=REPLACE_WITH_FRESH_BACKTESTER_BOT_TOKEN
HEDGE_RISK_REVIEWER_BOT_TOKEN=REPLACE_WITH_FRESH_RISK_REVIEWER_BOT_TOKEN
